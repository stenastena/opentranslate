  "cards": [
    {
      "dot": "cyan",
      "title": "Capture",
      "items": [
        "keyEmulator.ts sends raw Win32 SendInput scan codes via koffi, not nut-js",
        "Clipboard is saved, cleared, polled, then restored"
      ]
    },
    {
      "dot": "emerald",
      "title": "Translate",
      "items": [
        "ProviderRegistry isolates each adapter so one failing never crashes the app",
        "Google alone returns dictionary data and shells to curl to dodge TLS fingerprinting"
      ]
    },
    {
      "dot": "rose",
      "title": "IPC & persistence",
      "items": [
        "Renderers run with contextIsolation:true, nodeIntegration:false; preload exposes a fixed electronAPI surface",
        "Settings/history are local JSON; TTS shells to powershell.exe using Windows SAPI"
      ]
    }
  ]
